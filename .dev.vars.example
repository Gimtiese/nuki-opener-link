# Copy to .dev.vars for `npm run preview` / `npm run dev:worker`. Never commit .dev.vars.
NUKI_API_TOKEN=fake-token-nothing-opens
NUKI_SMARTLOCK_ID=123456789
ACCESS_PIN=12345678

# Cloudflare's official Turnstile TEST secret (always passes). Remove the line to test without Turnstile.
# Pair it with the test site key: VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA npm run preview
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
