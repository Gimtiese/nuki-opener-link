{
  "name": "nuki-opener-link",
  "version": "1.0.0",
  "description": "One-button web page that lets delivery people buzz open your door via a Nuki Opener. Vue 3 + TypeScript on Cloudflare Workers.",
  "private": true,
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Gimtiese/nuki-opener-link.git" },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "smartlocks": "node scripts/list-smartlocks.mjs"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4.147.0"
  }
}
