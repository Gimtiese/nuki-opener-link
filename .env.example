# Build-time settings, copy to .env (all optional). These end up in the public page, so
# put only information there that visitors may see. Never put secrets here.

# Heading and browser title (default: "Front door" / "Haustür")
# VITE_SITE_TITLE=Front door

# Phone numbers shown when something goes wrong: JSON array, "label" is optional
# VITE_CONTACTS='[{"label":"Anna","phone":"+49 160 1234567"}]'

# Language: auto (browser language, default), en or de
# VITE_LOCALE=auto
