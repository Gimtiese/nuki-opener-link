# Build-time settings for the page. `npm run setup` writes this file for you.
# Everything here becomes part of the PUBLIC page: never put secrets here.

# Heading and browser title (default: "Front door" / "Haustür")
# VITE_SITE_TITLE=Front door

# Phone numbers shown when something goes wrong: JSON array, "label" is optional
# VITE_CONTACTS='[{"label":"Anna","phone":"+49 160 1234567"}]'

# Language: auto (browser language, default), en or de
# VITE_LOCALE=auto

# Cloudflare Turnstile site key (public). Needs the TURNSTILE_SECRET_KEY Worker secret.
# VITE_TURNSTILE_SITE_KEY=
